# Copy to .env and fill in GROQ_API_KEY. Defaults run locally with no external services.

# --- LLM (Groq, free tier works: https://console.groq.com/keys) ---
LLM_PROVIDER=groq                  # groq | fake (offline, deterministic)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2

# --- Storage ---
# DATABASE_URL=sqlite:///./data/lms.db          # default; Postgres: postgresql+psycopg://user:pass@host/db
# QDRANT_URL=http://localhost:6333              # set to use a Qdrant server; unset = embedded file mode
# QDRANT_PATH=./data/qdrant

# --- Background jobs ---
TASK_BACKEND=local                 # local (in-process thread) | celery (Redis + worker, Docker)
# REDIS_URL=redis://localhost:6379/0

# --- Models ---
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium | large-v3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Behaviour ---
COMPLETION_THRESHOLD=0.9
DEFAULT_NUM_QUESTIONS=8
LOG_LEVEL=INFO
LOG_JSON=false                     # true = JSON log lines (recommended in Docker)
